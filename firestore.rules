rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isLoggedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isLoggedIn() && request.auth.uid == uid;
    }

    function isTourAdmin(tourId) {
      return isLoggedIn() && (
        request.auth.uid == get(/databases/$(database)/documents/tours/$(tourId)).data.adminId ||
        (get(/databases/$(database)/documents/tours/$(tourId)).data.adminIds != null &&
         request.auth.uid in get(/databases/$(database)/documents/tours/$(tourId)).data.adminIds)
      );
    }

    match /users/{userId} {
      allow read: if isLoggedIn();
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    match /tours/{tourId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn();
      allow update: if isLoggedIn();
      allow delete: if isLoggedIn() && (
        resource.data.adminId == request.auth.uid ||
        (resource.data.adminIds != null && request.auth.uid in resource.data.adminIds) ||
        isTourAdmin(tourId)
      );

      match /members/{memberId} {
        allow read: if isLoggedIn();
        allow create, update: if isLoggedIn();
        allow delete: if isTourAdmin(tourId);
      }

      match /expenses/{expenseId} {
        allow read, create, update: if isLoggedIn();
        allow delete: if isTourAdmin(tourId);
      }

      match /settlements/{settlementId} {
        allow read, create, update: if isLoggedIn();
        allow delete: if isTourAdmin(tourId);
      }

      match /categories/{categoryId} {
        allow read: if isLoggedIn();
        allow create, update, delete: if isTourAdmin(tourId);
      }

      match /join_requests/{requestId} {
        allow read, create, update, delete: if isLoggedIn();
      }
    }

    match /invites/{inviteId} {
      allow create: if isLoggedIn();
      allow update: if isLoggedIn();
      allow delete: if false;
    }

    match /app_config/{configId} {
      allow read: if true;
      allow write: if isLoggedIn();
    }
  }
}
